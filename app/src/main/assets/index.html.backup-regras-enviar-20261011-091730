async function createAccount(event){

    event.preventDefault();

    const fullName =
        document
            .getElementById("registerFullName")
            .value
            .trim()
            .replace(/\s+/g, " ");

    const email =
        document
            .getElementById("registerEmail")
            .value
            .trim()
            .toLowerCase();

    const password =
        document
            .getElementById("registerPassword")
            .value;

    const confirmation =
        document
            .getElementById(
                "registerPasswordConfirm"
            )
            .value;

    const club =
        document
            .getElementById("registerClub")
            .value;

    const button =
        document
            .getElementById("registerButton");

    setRegisterError("");
    setRegisterSuccess("");

    if(
        !fullName ||
        !email ||
        !password ||
        !confirmation ||
        !club
    ){

        setRegisterError(
            "Preencha todos os campos."
        );

        return;
    }

    const nameParts =
        fullName.split(/\s+/).filter(Boolean);

    if(nameParts.length < 2){

        setRegisterError(
            "Informe seu nome e sobrenome."
        );

        return;
    }

    if(password.length < 6){

        setRegisterError(
            "A senha deve ter pelo menos 6 caracteres."
        );

        return;
    }

    if(password !== confirmation){

        setRegisterError(
            "As senhas não coincidem."
        );

        return;
    }

    button.disabled = true;

    button.textContent =
        "Criando conta...";

    try{

        const {
            data: nomePermitido,
            error: erroValidacaoNome
        } = await supabaseClient.rpc(
            "nome_completo_sem_termos_proibidos",
            { p_nome: fullName }
        );

        if(erroValidacaoNome){

            console.error(
                "Erro ao validar nome:",
                erroValidacaoNome
            );

            setRegisterError(
                "Não foi possível validar o nome. Tente novamente."
            );

            return;
        }

        if(nomePermitido !== true){

            setRegisterError(
                "O nome informado contém termos não permitidos."
            );

            return;
        }

        const {
            data: emailPermitido,
            error: erroValidacaoEmail
        } = await supabaseClient.rpc(
            "email_sem_termos_proibidos",
            { p_email: email }
        );

        if(erroValidacaoEmail){

            console.error(
                "Erro ao validar e-mail:",
                erroValidacaoEmail
            );

            setRegisterError(
                "Não foi possível validar o e-mail. Tente novamente."
            );

            return;
        }

        if(emailPermitido !== true){

            setRegisterError(
                "O e-mail informado contém termos não permitidos."
            );

            return;
        }

        const {
            data,
            error
        } =
            await supabaseClient.auth.signUp({
                email:email,
                password:password,
                options:{
                    emailRedirectTo: "brasileirao://login-callback",
                    data:{
                        nome_completo:fullName,
                        clube:club
                    }
                }
            });

        if(error){

            console.error(
                "Erro Supabase:",
                error
            );

            let message =
                error.message ||
                "Não foi possível criar a conta.";

            if(
                message
                    .toLowerCase()
                    .includes(
                        "already registered"
                    )
            ){

                message =
                    "Este e-mail já está cadastrado.";

            }

            setRegisterError(
                message
            );

            return;
        }

        if(
            data &&
            data.user
        ){

            setRegisterSuccess(
                "Cadastro iniciado! Enviamos um e-mail de confirmação para " +
                email +
                ". Abra a mensagem e confirme seu endereço antes de entrar no aplicativo."
            );

            document
                .getElementById(
                    "registerPassword"
                )
                .value = "";

            document
                .getElementById(
                    "registerPasswordConfirm"
                )
                .value = "";

        }

    }catch(error){

        console.error(
            "Erro inesperado:",
            error
        );

        setRegisterError(
            "Erro ao conectar ao servidor."
        );

    }finally{

        button.disabled = false;

        button.textContent =
            "Criar minha conta";

    }

}


