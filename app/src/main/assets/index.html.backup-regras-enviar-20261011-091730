async function loadCalendar(){

    setStatus(
        "Verificando rodada aberta..."
    );

    try{

        /*
         * Não chamamos loadOpenRound() novamente aqui.
         * finishAuthenticatedLogin() já descobriu a rodada.
         */

        roundLockedByTime = false;

        if(!RODADA_ATUAL){

            gamesElement.innerHTML = `
                <div class="game">

                    <b>
                        Nenhuma rodada aberta para palpites.
                    </b>

                    <p
                        style="
                            font-size:11px;
                            color:#667169
                        ">

                        Aguarde a abertura da próxima rodada.

                    </p>

                </div>
            `;

            setStatus(
                "⚠ Nenhuma rodada aberta"
            );

            updatePredictionCounter();

            return;
        }

        setStatus(
            "Carregando jogos da Rodada " +
            RODADA_ATUAL +
            "..."
        );

        const {
            data,
            error
        } =
            await supabaseClient
                .from(
                    "calendario_brasileirao"
                )
                .select(`
                    ref_cbf,
                    rodada,
                    mandante,
                    visitante,
                    data_prevista,
                    hora_prevista,
                    status
                `)
                .eq(
                    "temporada",
                    TEMPORADA_ATUAL
                )
                .eq(
                    "rodada",
                    RODADA_ATUAL
                )
                .eq(
                    "aberta_para_palpite",
                    true
                )
                .order(
                    "data_prevista",
                    {
                        ascending:true,
                        nullsFirst:false
                    }
                )
                .order(
                    "hora_prevista",
                    {
                        ascending:true,
                        nullsFirst:false
                    }
                )
                .order(
                    "ref_cbf",
                    {
                        ascending:true
                    }
                );

        if(error){

            console.error(
                "Erro ao carregar calendário:",
                error
            );

            gamesElement.innerHTML = `
                <div class="game">

                    <b>
                        Não foi possível carregar os jogos.
                    </b>

                    <p
                        style="
                            font-size:11px;
                            color:#667169
                        ">

                        Verifique sua conexão e tente novamente.

                    </p>

                </div>
            `;

            setStatus(
                "⚠ Erro ao carregar jogos"
            );

            return;
        }

        if(
            !data ||
            data.length === 0
        ){

            gamesElement.innerHTML = `
                <div class="game">

                    <b>
                        Nenhum jogo encontrado.
                    </b>

                    <p
                        style="
                            font-size:11px;
                            color:#667169
                        ">

                        A rodada ainda não foi cadastrada.

                    </p>

                </div>
            `;

            setStatus(
                "⚠ Nenhum jogo cadastrado"
            );

            updatePredictionCounter();

            return;
        }

        /*
         * O primeiro jogo da rodada é o que define
         * o encerramento dos palpites.
         *
         * A data é date e a hora é time.
         * O horário é interpretado como horário de Brasília.
         */

        countdownDeadline =
            data[0].data_prevista &&
            data[0].hora_prevista
                ? `${data[0].data_prevista}T${String(data[0].hora_prevista).slice(0,8)}-03:00`
                : null;

        startCountdown();

        m =
            data.map(
                jogo => [

                    formatarDataJogo(
                        jogo.data_prevista
                    ),

                    jogo.mandante,

                    jogo.visitante,

                    jogo.ref_cbf

                ]
            );

        renderGames();

        setStatus(
            "✓ " +
            m.length +
            " jogos carregados · Rodada " +
            RODADA_ATUAL
        );

    }catch(error){

        console.error(
            "Erro inesperado ao carregar calendário:",
            error
        );

        setStatus(
            "⚠ Erro de conexão"
        );

    }

}


