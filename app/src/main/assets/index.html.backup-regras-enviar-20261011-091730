function formatarDataJogo(data){

    if(!data){
        return "Data não definida";
    }

    const dataObj =
        new Date(
            data + "T12:00:00"
        );

    if(
        Number.isNaN(
            dataObj.getTime()
        )
    ){

        return data;

    }

    return dataObj.toLocaleDateString(
        "pt-BR",
        {
            weekday:"short",
            day:"2-digit",
            month:"2-digit"
        }
    );

}


