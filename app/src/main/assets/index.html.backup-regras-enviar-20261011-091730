async function saveNewPassword(){

    const password = document.getElementById("newPassword").value;
    const confirmation = document.getElementById("confirmNewPassword").value;
    const button = document.getElementById("saveNewPasswordButton");
    const errorElement = document.getElementById("newPasswordError");

    errorElement.textContent = "";

    if(password.length < 6){
        errorElement.textContent = "A senha deve ter pelo menos 6 caracteres.";
        return;
    }

    if(password !== confirmation){
        errorElement.textContent = "As senhas não coincidem.";
        return;
    }

    button.disabled = true;
    button.textContent = "Salvando...";

    try{

        const { error } = await supabaseClient.auth.updateUser({
            password: password
        });

        if(error){
            console.error("Erro ao atualizar senha:", error);
            const detalheErro = String(error.message || error.code || "").toLowerCase();

            if (
                detalheErro.includes("different from the old password") ||
                detalheErro.includes("same password") ||
                detalheErro.includes("same as the old password") ||
                detalheErro.includes("password reuse") ||
                detalheErro.includes("previous password") ||
                detalheErro.includes("already been used")
            ) {
                errorElement.textContent =
                    "A nova senha deve ser diferente da senha anterior. Escolha outra senha.";
            } else {
                errorElement.textContent = error.message
                    ? "Não foi possível alterar a senha: " + error.message
                    : "Não foi possível alterar a senha. Tente novamente.";
            }
            return;
        }

        await supabaseClient.auth.signOut();
        currentUser = null;

        document.getElementById("newPasswordFields").style.display = "none";

        const successElement = document.getElementById("newPasswordSuccess");
        successElement.textContent = "Senha alterada com sucesso. Agora você pode entrar com sua nova senha.";
        successElement.style.display = "block";

        document.getElementById("newPasswordDoneButton").style.display = "block";

    }catch(error){

        console.error("Erro ao salvar nova senha:", error);
        const detalheErro = String(error.message || error.code || "").toLowerCase();

        if (
            detalheErro.includes("different from the old password") ||
            detalheErro.includes("same password") ||
            detalheErro.includes("same as the old password") ||
            detalheErro.includes("password reuse") ||
            detalheErro.includes("previous password") ||
            detalheErro.includes("already been used")
        ) {
            errorElement.textContent =
                "A nova senha deve ser diferente da senha anterior. Escolha outra senha.";
        } else {
            errorElement.textContent = error.message
                ? "Não foi possível alterar a senha: " + error.message
                : "Ocorreu um erro ao alterar a senha. Tente novamente.";
        }

    }finally{

        button.disabled = false;
        button.textContent = "Salvar nova senha";

    }

}


