async function loadUserPredictions(){

    if(!currentUser){
        return;
    }

    if(
        !m.length ||
        !RODADA_ATUAL
    ){
        return;
    }

    try{

        const {
            data,
            error
        } =
            await supabaseClient.rpc(
                "carregar_palpites_rodada",
                {
                    p_rodada:
                        RODADA_ATUAL
                }
            );

        if(error){

            console.error(
                "Erro ao carregar palpites:",
                error
            );

            setStatus(
                "⚠ Não foi possível carregar seus palpites"
            );

            return;
        }

        if(!data){

            updatePredictionCounter();

            return;
        }

        let enviadoEm = null;

        data.forEach(
            prediction => {

                if(
                    prediction.enviado_em
                ){

                    enviadoEm =
                        prediction.enviado_em;

                }

                const index =
                    m.findIndex(
                        game =>

                            normalizarTime(
                                game[1]
                            ) ===
                            normalizarTime(
                                prediction.mandante
                            )

                            &&

                            normalizarTime(
                                game[2]
                            ) ===
                            normalizarTime(
                                prediction.visitante
                            )
                    );

                if(index < 0){
                    return;
                }

                const home =
                    document.querySelector(
                        `.score input[data-i="${index}"][data-s="h"]`
                    );

                const away =
                    document.querySelector(
                        `.score input[data-i="${index}"][data-s="a"]`
                    );

                if(home){

                    home.value =
                        prediction.palpite_mandante ?? "";

                }

                if(away){

                    away.value =
                        prediction.palpite_visitante ?? "";

                }

            }
        );

        updatePredictionCounter();

        if(enviadoEm){

            showSubmittedState(
                enviadoEm
            );

            setStatus(
                "✓ Palpites já enviados"
            );

        }else{

            setStatus(
                "✓ Palpites carregados"
            );

        }

    }catch(error){

        console.error(
            "Erro ao carregar palpites:",
            error
        );

        setStatus(
            "⚠ Erro ao carregar palpites"
        );

    }

}


/* ============================================================
VALIDAR
============================================================ */

function validarPlacar(valor){

    if(
        valor === null ||
        valor === undefined ||
        valor === ""
    ){

        return false;

    }

    const numero =
        Number(valor);

    return (
        Number.isInteger(numero) &&
        numero >= 0 &&
        numero <= 20
    );

}


/* ============================================================
CONTADOR
============================================================ */

function updatePredictionCounter(){

    const counter =
        document.getElementById(
            "predictionCounter"
        );

    const sendButton =
        document.getElementById(
            "sendPredictionsButton"
        );

    if(!counter){
        return;
    }

    const gamesCount =
        m.length;

    let completed = 0;

    for(
        let i = 0;
        i < gamesCount;
        i++
    ){

        const home =
            document.querySelector(
                `.score input[data-i="${i}"][data-s="h"]`
            );

        const away =
            document.querySelector(
                `.score input[data-i="${i}"][data-s="a"]`
            );

        if(
            home &&
            away &&
            validarPlacar(
                home.value
            ) &&
            validarPlacar(
                away.value
            )
        ){

            completed++;

        }

    }

    counter.textContent =
        completed +
        " de " +
        gamesCount +
        " palpites preenchidos";

    if(sendButton){

        sendButton.disabled =
            completed !== gamesCount ||
            !currentUser ||
            !RODADA_ATUAL ||
            roundLockedByTime;

    }

}


