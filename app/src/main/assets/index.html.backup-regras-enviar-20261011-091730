body.dark-mode textarea,
body.dark-mode select {
    background-color: #111827;
    color: #f9fafb;
    border-color: #4b5563;
}

body.dark-mode .ranking-table tbody tr:nth-child(even),
body.dark-mode .ranking-table tbody tr:hover {
    background-color: #273449 !important;
}

.settings-preference {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 13px 0;
    border-bottom: 1px solid #e5e7eb;
}

.settings-preference:last-of-type {
    border-bottom: 0;
}

.settings-preference input[type="checkbox"] {
    width: 21px;
    height: 21px;
    flex-shrink: 0;
    accent-color: #254aa5;
    cursor: pointer;
}

body.dark-mode .settings-preference {
    border-color: #374151;
}

