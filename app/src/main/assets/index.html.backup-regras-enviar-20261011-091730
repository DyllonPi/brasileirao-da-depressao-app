async function savePrediction(index){

    if(roundLockedByTime){

        setStatus(
            "🔒 A rodada já começou. Os palpites não podem mais ser alterados."
        );

        return;

    }

    if(!currentUser){

        setStatus(
            "⚠ Faça login para salvar seus palpites"
        );

        return;
    }

    if(!RODADA_ATUAL){

        setStatus(
            "⚠ Nenhuma rodada aberta"
        );

        return;
    }

    const game =
        m[index];

    if(!game){
        return;
    }

    const homeInput =
        document.querySelector(
            `.score input[data-i="${index}"][data-s="h"]`
        );

    const awayInput =
        document.querySelector(
            `.score input[data-i="${index}"][data-s="a"]`
        );

    if(
        !homeInput ||
        !awayInput
    ){
        return;
    }

    const homeValue =
        homeInput.value === ""
            ? null
            : Number(
                homeInput.value
              );

    const awayValue =
        awayInput.value === ""
            ? null
            : Number(
                awayInput.value
              );

    if(
        !validarPlacar(homeValue) ||
        !validarPlacar(awayValue)
    ){
        return;
    }

    try{

        const {
            data,
            error
        } =
            await supabaseClient.rpc(
                "salvar_palpite",
                {
                    p_rodada:
                        RODADA_ATUAL,

                    p_mandante:
                        game[1],

                    p_visitante:
                        game[2],

                    p_palpite_mandante:
                        homeValue,

                    p_palpite_visitante:
                        awayValue
                }
            );

        if(error){

            console.error(
                "Erro ao salvar palpite:",
                error
            );

            setStatus(
                "⚠ " +
                (
                    error.message ||
                    "Não foi possível salvar"
                )
            );

            if(
                error.message &&
                error.message
                    .toLowerCase()
                    .includes(
                        "já começou"
                    )
            ){

                lockPredictionsByTime();

            }

            return;
        }

        console.log(
            "Palpite salvo:",
            data
        );

        updatePredictionCounter();

        setStatus(
            "✓ Palpite salvo"
        );

    }catch(error){

        console.error(
            "Erro inesperado:",
            error
        );

        setStatus(
            "⚠ Erro de conexão"
        );

    }

}


/* ============================================================
EVENTOS DOS PALPITES
============================================================ */

function attachPredictionEvents(){

    document
        .querySelectorAll(
            ".score input"
        )
        .forEach(
            element => {

                element.addEventListener(
                    "input",
                    function(){

                        if(
                            this.value !== "" &&
                            Number(this.value) > 20
                        ){

                            this.value = "20";

                        }

                        if(
                            this.value !== "" &&
                            Number(this.value) < 0
                        ){

                            this.value = "0";

                        }

                        updatePredictionCounter();

                        const index =
                            Number(
                                this.dataset.i
                            );

                        if(
                            predictionSaveTimers[index]
                        ){

                            clearTimeout(
                                predictionSaveTimers[index]
                            );

                        }

                        predictionSaveTimers[index] =
                            setTimeout(
                                function(){

                                    savePrediction(
                                        index
                                    );

                                },
                                500
                            );

                    }
                );

            }
        );

    updatePredictionCounter();

}


/* ============================================================
ESTADO ENVIADO
============================================================ */

function showSubmittedState(enviadoEm){

    if(gamesElement){

        gamesElement.style.display =
            "block";

    }

    const guide =
        document.querySelector(
            ".guide"
        );

    if(guide){

        guide.style.display =
            "block";

    }

    document
        .querySelectorAll(
            ".score input"
        )
        .forEach(
            input => {

                input.disabled =
                    true;

            }
        );

    const footer =
        document.getElementById(
            "predictionFooter"
        );

    if(!footer){
        return;
    }

    let dataFormatada = "";

    if(enviadoEm){

        const data =
            new Date(
                enviadoEm
            );

        if(
            !Number.isNaN(
                data.getTime()
            )
        ){

            dataFormatada =
                data.toLocaleString(
                    "pt-BR"
                );

        }

    }

    footer.innerHTML = `

        <div class="send-success">

            <div class="send-success-icon">
                ✓
            </div>

            <h3 class="send-success-title">
                Palpites enviados!
            </h3>

            <p class="send-success-text">

                Seus palpites da
                <b>Rodada ${RODADA_ATUAL}</b>
                foram registrados com sucesso.

            </p>

            <p class="send-success-small">

                ${
                    dataFormatada
                        ? "Enviado em " +
                          dataFormatada +
                          ". "
                        : ""
                }

                Os palpites não podem mais ser alterados.

            </p>

        </div>

    `;

}


/* ============================================================
ENVIAR
============================================================ */

function sendPredictions(){

    if(roundLockedByTime){

        setStatus(
            "🔒 A rodada já começou. Os palpites não podem mais ser enviados."
        );

        return;

    }

    if(!currentUser){

        setStatus(
            "⚠ Faça login para enviar seus palpites"
        );

        return;
    }

    if(!RODADA_ATUAL){

        setStatus(
            "⚠ Nenhuma rodada aberta"
        );

        return;
    }

    if(isSendingPredictions){
        return;
    }

    const confirmation =
        document.getElementById(
            "sendConfirmation"
        );

    if(confirmation){

        confirmation.classList.add(
            "show"
        );

    }

}


async function confirmSendPredictions(){

    const confirmation =
        document.getElementById(
            "sendConfirmation"
        );

    if(confirmation){

        confirmation.classList.remove(
            "show"
        );

    }

    if(!currentUser){

        setStatus(
            "⚠ Faça login para enviar seus palpites"
        );

        return;
    }

    if(!RODADA_ATUAL){

        setStatus(
            "⚠ Nenhuma rodada aberta"
        );

        return;
    }

    if(isSendingPredictions){
        return;
    }

    isSendingPredictions = true;

    const confirmButton =
        document.getElementById(
            "confirmSendButton"
        );

    if(confirmButton){

        confirmButton.disabled = true;

        confirmButton.textContent =
            "ENVIANDO...";

    }

    try{

        const {
            data,
            error
        } =
            await supabaseClient.rpc(
                "enviar_palpites",
                {
                    p_rodada:
                        RODADA_ATUAL
                }
            );

        if(error){

            console.error(
                "Erro ao enviar palpites:",
                error
            );

            setStatus(
                "⚠ " +
                (
                    error.message ||
                    "Não foi possível enviar os palpites."
                )
            );

            if(
                error.message &&
                error.message
                    .toLowerCase()
                    .includes(
                        "já começou"
                    )
            ){

                lockPredictionsByTime();

            }

            return;
        }

        const dataEnvio =
            data &&
            data.enviado_em
                ? data.enviado_em
                : new Date().toISOString();

        showSubmittedState(
            dataEnvio
        );

        setStatus(
            "✓ Palpites enviados com sucesso!"
        );

    }catch(error){

        console.error(
            "Erro inesperado ao enviar palpites:",
            error
        );

        setStatus(
            "⚠ Erro de conexão ao enviar"
        );

    }finally{

        isSendingPredictions = false;

        if(confirmButton){

            confirmButton.disabled = false;

            confirmButton.textContent =
                "CONFIRMAR ENVIO";

        }

    }

}


/* ============================================================
BLOQUEIO POR HORÁRIO
============================================================ */

function lockPredictionsByTime(){

    roundLockedByTime = true;

    document
        .querySelectorAll(
            ".score input"
        )
        .forEach(
            input => {

                input.disabled = true;

            }
        );

    const sendButton =
        document.getElementById(
            "sendPredictionsButton"
        );

    if(sendButton){

        sendButton.disabled = true;

    }

    const confirmation =
        document.getElementById(
            "sendConfirmation"
        );

    if(confirmation){

        confirmation.classList.remove(
            "show"
        );

    }

    const message =
        document.getElementById(
            "sendPredictionsMessage"
        );

    if(message){

        message.textContent =
            "A rodada já começou. Os palpites não podem mais ser alterados ou enviados.";

    }

    setStatus(
        "🔒 Rodada iniciada — palpites encerrados"
    );

}

function unlockPredictions(){

    roundLockedByTime = false;

    document
        .querySelectorAll(
            ".score input"
        )
        .forEach(
            input => {

                input.disabled = false;

            }
        );

    updatePredictionCounter();

}


/* ============================================================
TEMPORIZADOR
============================================================ */

function startCountdown(){

    if(countdownInterval){

        clearInterval(
            countdownInterval
        );

    }

    roundLockedByTime = false;

    if(!countdownDeadline){

        document.getElementById(
            "clock"
        ).textContent =
            "00d 00:00:00";

        return;

    }

    function updateClock(){

        const now =
            new Date().getTime();

        const target =
            new Date(
                countdownDeadline
            ).getTime();

        const diff =
            target - now;

        if(diff <= 0){

            document.getElementById(
                "clock"
            ).textContent =
                "ENCERRADO";

            clearInterval(
                countdownInterval
            );

            lockPredictionsByTime();

            return;

        }

        const days =
            Math.floor(
                diff /
                (1000 * 60 * 60 * 24)
            );

        const hours =
            Math.floor(
                (
                    diff %
                    (1000 * 60 * 60 * 24)
                ) /
                (1000 * 60 * 60)
            );

        const minutes =
            Math.floor(
                (
                    diff %
                    (1000 * 60 * 60)
                ) /
                (1000 * 60)
            );

        const seconds =
            Math.floor(
                (
                    diff %
                    (1000 * 60)
                ) /
                1000
            );

        const clock =
            document.getElementById(
                "clock"
            );

        if(clock){

            clock.textContent =
                String(days).padStart(2,"0") +
                "d " +
                String(hours).padStart(2,"0") +
                ":" +
                String(minutes).padStart(2,"0") +
                ":" +
                String(seconds).padStart(2,"0");

        }

    }

    updateClock();

    countdownInterval =
        setInterval(
            updateClock,
            1000
        );

}


