<!doctype html>
<html lang="pt-BR">

<head>

<meta charset="utf-8">

<meta
    name="viewport"
    content="width=device-width,initial-scale=1">

<title>Brasileirão da Depressão</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>

*{
    box-sizing:border-box
}

body{
    margin:0;
    background:#fbfaf5;
    color:#171717;
    font-family:Arial,sans-serif
}

#loginScreen{
    position:fixed;
    inset:0;
    z-index:9999;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:24px;
    background:linear-gradient(145deg,#071b33,#0d3157);
    overflow-y:auto;
}

.login-card{
    width:100%;
    max-width:390px;
    padding:32px 28px;
    background:#fff;
    border-radius:24px;
    text-align:center;
    box-shadow:0 20px 60px rgba(0,0,0,.30);
}

.login-logo{
    width:120px;
    height:120px;
    object-fit:contain;
    display:block;
    margin:0 auto 18px;
}

.login-title{
    margin:0;
    color:#0b2340;
    font:700 27px Georgia,serif;
}

.login-subtitle{
    margin:10px 0 26px;
    color:#687789;
    font-size:15px;
    line-height:1.5;
}

.google-login-button{
    width:100%;
    min-height:52px;
    border:1px solid #dadce0;
    border-radius:12px;
    background:#fff;
    color:#202124;
    font-size:16px;
    font-weight:600;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:12px;
    transition:.2s;
}

.google-login-button:active{
    transform:scale(.98);
}

.google-login-button:disabled{
    opacity:.7;
}

.google-icon{
    width:20px;
    height:20px;
}

.login-divider{
    display:flex;
    align-items:center;
    gap:12px;
    margin:20px 0;
    color:#9aa3ad;
    font-size:12px;
}

.login-divider::before,
.login-divider::after{
    content:"";
    flex:1;
    height:1px;
    background:#e1e4e7;
}

.create-account-button{
    width:100%;
    min-height:50px;
    border:0;
    border-radius:11px;
    background:#254aa5;
    color:#fff;
    font-size:15px;
    font-weight:700;
    cursor:pointer;
    transition:.2s;
}

.create-account-button:active{
    transform:scale(.98);
}

.login-button{
    width:100%;
    min-height:50px;
    margin-top:4px;
    border:0;
    border-radius:11px;
    background:#254aa5;
    color:#fff;
    font-size:15px;
    font-weight:700;
    cursor:pointer;
    transition:.2s;
}

.login-button:active{
    transform:scale(.98);
}

.login-button:disabled,
.create-account-button:disabled{
    opacity:.65;
    cursor:not-allowed;
}

.back-login-button{
    width:100%;
    margin-top:15px;
    padding:10px;
    border:0;
    background:transparent;
    color:#254aa5;
    font-size:13px;
    cursor:pointer;
}

.login-input{
    width:100%;
    height:48px;
    margin-bottom:11px;
    padding:0 14px;
    border:1px solid #d5d9dd;
    border-radius:10px;
    background:#fff;
    color:#202124;
    font-size:14px;
    outline:none;
}

.login-input:focus{
    border-color:#254aa5;
    box-shadow:0 0 0 2px rgba(37,74,165,.10);
}

.login-input::placeholder{
    color:#8a949f;
}

.password-field{
    position:relative;
    width:100%;
    margin-bottom:11px;
}

.password-field .login-input{
    margin-bottom:0;
    padding-right:48px;
}

.password-toggle{
    position:absolute;
    right:8px;
    top:24px;
    transform:translateY(-50%);
    width:36px;
    height:36px;
    padding:7px;
    border:0;
    border-radius:6px;
    background:transparent;
    color:#526174;
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
    z-index:2;
}

.password-toggle svg{
    width:22px;
    height:22px;
    display:block;
}

.password-toggle:focus-visible{
    outline:2px solid #254aa5;
    outline-offset:2px;
}

select.login-input{
    appearance:auto;
}

.register-error{
    min-height:17px;
    margin:2px 0 10px;
    color:#c62828;
    font-size:12px;
    line-height:1.4;
}

.register-success{
    min-height:17px;
    margin:2px 0 10px;
    color:#28755e;
    font-size:12px;
    line-height:1.4;
}

.login-footer{
    margin-top:22px;
    color:#8a96a3;
    font-size:12px;
}


/* ============================================================
TELA OBRIGATÓRIA DO TIME DO CORAÇÃO
============================================================ */

#clubRequiredScreen{
    position:fixed;
    inset:0;
    z-index:10000;
    display:none;
    align-items:center;
    justify-content:center;
    padding:24px;
    background:linear-gradient(145deg,#071b33,#0d3157);
    overflow-y:auto;
}

.club-required-card{
    width:100%;
    max-width:390px;
    padding:32px 28px;
    background:#fff;
    border-radius:24px;
    text-align:center;
    box-shadow:0 20px 60px rgba(0,0,0,.30);
}

.club-required-icon{
    width:72px;
    height:72px;
    margin:0 auto 18px;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:#254aa5;
    color:#e2c300;
    font:700 32px Georgia,serif;
}

.club-required-title{
    margin:0;
    color:#0b2340;
    font:700 25px Georgia,serif;
}

.club-required-text{
    margin:11px 0 23px;
    color:#687789;
    font-size:14px;
    line-height:1.5;
}

.club-required-email{
    margin:-12px 0 18px;
    color:#8a949f;
    font-size:11px;
    word-break:break-word;
}

.club-required-button{
    width:100%;
    min-height:50px;
    border:0;
    border-radius:11px;
    background:#254aa5;
    color:#fff;
    font-size:15px;
    font-weight:700;
    cursor:pointer;
    transition:.2s;
}

.club-required-button:active{
    transform:scale(.98);
}

.club-required-button:disabled{
    opacity:.55;
    cursor:not-allowed;
}

.club-required-error{
    min-height:17px;
    margin:10px 0 0;
    color:#c62828;
    font-size:12px;
    line-height:1.4;
}

.club-required-note{
    margin-top:18px;
    color:#8a96a3;
    font-size:11px;
    line-height:1.4;
}

.club-required-logout{
    width:100%;
    margin-top:8px;
    padding:10px;
    border:0;
    background:transparent;
    color:#254aa5;
    font-size:12px;
    cursor:pointer;
}


.top{
    height:64px;
    padding:0 20px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-bottom:1px solid #d9ddd2;
    font-weight:700;
}

.mark{
    display:grid;
    place-items:center;
    width:30px;
    height:30px;
    background:#254aa5;
    color:#e2c300;
    border-radius:50%;
    font:italic 20px Georgia;
    margin-right:9px;
}

.hero{
    background:#254aa5;
    color:white;
    padding:35px 23px;
    margin:20px 16px 38px;
    position:relative;
    overflow:hidden;
    border:3px solid #e2c300;
    box-shadow:5px 5px 0 #171717;
}

.hero:after{
    content:attr(data-round);
    position:absolute;
    right:-15px;
    bottom:-53px;
    color:rgba(255,255,255,0.15);
    font:bold 150px Georgia;
    pointer-events:none;
    z-index:0;
}

.hero *{
    position:relative;
    z-index:2;
}

.eyebrow{
    margin:0 0 8px;
    color:#e2c300;
    font:10px monospace;
    letter-spacing:1px;
}

.hero h1{
    margin:0;
    font:700 35px Georgia;
    line-height:.98;
}

.hero h1 i{
    color:#e2c300;
}

.intro{
    color:#d5e4dc;
    font-size:14px;
    line-height:1.5;
    max-width:290px;
}

.timer{
    border:1px solid #a2c52f;
    padding:12px;
    margin-top:24px;
    font:11px monospace;
    color:#d5e4dc;
}

.timer b{
    display:block;
    color:#e2c300;
    font-size:22px;
    margin:7px 0;
}

.main{
    padding:0 16px 44px;
}

.head{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    margin-bottom:17px;
}

.head h2{
    margin:0;
    font:700 26px Georgia;
}

.hint{
    font-size:10px;
    color:#667169;
    text-align:right;
    max-width:150px;
}

.game{
    background:white;
    border:1px solid #d9ddd2;
    padding:15px;
    margin-bottom:11px;
}

.meta{
    display:flex;
    justify-content:space-between;
    color:#667169;
    font:10px monospace;
}

.teams{
    display:grid;
    grid-template-columns:1fr auto 1fr;
    gap:8px;
    align-items:center;
    margin:14px 0;
}

.teams b:first-child{
    text-align:right;
}

.teams span{
    font:10px monospace;
    color:#8a958c;
}

.score{
    display:flex;
    justify-content:center;
    gap:7px;
    align-items:center;
}

.score input{
    width:45px;
    height:39px;
    text-align:center;
    border:1px solid #c5cdc4;
    font:bold 17px monospace;
    color:#254aa5;
}

.score input:focus{
    outline:none;
    border-color:#254aa5;
    box-shadow:0 0 0 2px rgba(37,74,165,.10);
}

.score input:disabled{
    background:#eef1ec;
    color:#667169;
    cursor:not-allowed;
}

.guide{
    background:#e9eee3;
    color:#536057;
    font-size:11px;
    padding:13px;
    margin:19px 0 42px;
}

/* RANKING - PADRONIZADO COM O APP */

.header-container {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-bottom: 20px;
}

.header-container .back-button,
.header-container button:first-child {
    position: absolute;
    left: 0;
    margin: 0;
}

.header-container .title-wrapper,
.header-container h1,
.header-container h2 {
    text-align: center;
    margin: 0 auto;
}

/* --- DEMAIS ESTILOS --- */
.ranking-table-container{
    width:100%;
    overflow-x:auto;
    border:1px solid #d9ddd2;
    border-radius:8px;
    background:#fff;
    margin-top:15px;
    box-shadow:0 2px 8px rgba(0,0,0,0.04);
}

.ranking-table{
    width:100%;
    border-collapse:collapse;
    font-family:Arial,sans-serif;
    font-size:14px;
}

.ranking-table th{
    background-color:#254aa5;
    color:#fff;
    font-weight:bold;
    text-align:center;
    padding:12px;
    border-bottom:2px solid #0d3157;
}

.ranking-table td{
    padding:10px 12px;
    border-bottom:1px solid #eef1ec;
    color:#171717;
}

.ranking-table td.col-participante{
    text-align:left;
    font-weight:600;
}

.ranking-table td.col-pontuacao{
    text-align:center;
    font-weight:bold;
    color:#254aa5;
}

.ranking-table td.col-time{
    text-align:center;
    color:#667169;
}

.ranking-table tbody tr:nth-child(even){
    background-color:#f9fbf8;
}

.ranking-table tbody tr:hover{
    background-color:#eef4ff;
}

.crest{
    display:block;
    width:106px;
    height:106px;
    object-fit:cover;
    border-radius:50%;
    margin:-7px auto 20px;
    border:3px solid #e2c300;
    box-shadow:4px 4px 0 #171717;
}

.prediction-footer{
    margin:20px 0 24px;
    padding:16px;
    background:#fff;
    border:1px solid #d9ddd2;
}

.prediction-counter{
    margin-bottom:12px;
    font:bold 12px monospace;
    color:#536057;
}

.send-button{
    width:100%;
    min-height:50px;
    border:0;
    border-radius:10px;
    background:#254aa5;
    color:#fff;
    font-size:14px;
    font-weight:700;
    cursor:pointer;
    transition:.2s;
}

.send-button:disabled{
    opacity:.55;
    cursor:not-allowed;
}

.send-button:not(:disabled):active{
    transform:scale(.98);
}

.send-message{
    margin:10px 0 0;
    font-size:11px;
    color:#667169;
    line-height:1.4;
}

.send-success{
    text-align:center;
    padding:22px 10px;
}

.send-success-icon{
    font-size:42px;
    margin-bottom:10px;
}

.send-success-title{
    margin:0 0 8px;
    color:#28755e;
    font-size:21px;
}

.send-success-text{
    margin:0;
    color:#667169;
    font-size:13px;
    line-height:1.5;
}

.send-success-small{
    margin:10px 0 0;
    color:#8a958c;
    font-size:11px;
}

/* CONFIRMAÇÃO */

.send-confirmation{
    display:none;
    margin-top:14px;
    padding:16px;
    border:1px solid #d9ddd2;
    border-radius:12px;
    background:#f8f9f5;
}

.send-confirmation.show{
    display:block;
}

.send-confirmation-title{
    margin:0 0 8px;
    color:#0b2340;
    font-size:16px;
    font-weight:700;
}

.send-confirmation-text{
    margin:0 0 14px;
    color:#667169;
    font-size:12px;
    line-height:1.5;
}

.send-confirmation-actions{
    display:flex;
    gap:10px;
}

.send-confirmation-actions button{
    flex:1;
    min-height:44px;
    border-radius:9px;
    font-size:13px;
    font-weight:700;
    cursor:pointer;
}

.send-confirm-cancel{
    border:1px solid #cfd5cf;
    background:#fff;
    color:#536057;
}

.send-confirm-ok{
    border:0;
    background:#254aa5;
    color:#fff;
}


/* MENU LATERAL */

#menuButton{
    position:fixed;
    top:10px;
    left:14px;
    z-index:8990;
    width:44px;
    height:44px;
    border:0;
    border-radius:8px;
    background:#254aa5;
    color:#fff;
    font-size:22px;
    line-height:44px;
    cursor:pointer;
    box-shadow:0 4px 14px rgba(0,0,0,.22);
    display:none;
}

#menuButton:active{
    transform:scale(.96);
}

#menuOverlay{
    position:fixed;
    inset:0;
    z-index:8998;
    background:rgba(0,0,0,.45);
    opacity:0;
    visibility:hidden;
    transition:opacity .25s ease;
}

#sideMenu{
    position:fixed;
    top:0;
    left:0;
    bottom:0;
    width:285px;
    max-width:82vw;
    z-index:9000;
    background:#071b33;
    color:#fff;
    transform:translateX(-100%);
    transition:transform .25s ease;
    box-shadow:5px 0 22px rgba(0,0,0,.3);
    display:flex;
    flex-direction:column;
}

body.side-menu-open #sideMenu{
    transform:translateX(0);
}

body.side-menu-open #menuOverlay{
    opacity:1;
    visibility:visible;
}

.side-menu-header{
    min-height:82px;
    padding:18px 16px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:1px solid rgba(255,255,255,.12);
}

.side-menu-title{
    display:flex;
    align-items:center;
    gap:11px;
    font-family:Arial,sans-serif;
    font-size:15px;
    line-height:1.15;
}

.side-menu-title span{
    font-size:27px;
}

.side-menu-close{
    width:38px;
    height:38px;
    border:0;
    background:transparent;
    color:#fff;
    font-size:30px;
    cursor:pointer;
}

.side-menu-nav{
    padding:18px 12px;
}

.side-menu-item{
    width:100%;
    min-height:56px;
    -webkit-tap-highlight-color:transparent;
    touch-action:manipulation;
    margin-bottom:7px;
    padding:0 15px;
    border:0;
    border-radius:7px;
    background:transparent;
    color:#fff;
    display:flex;
    align-items:center;
    gap:14px;
    text-align:left;
    font:600 14px Arial,sans-serif;
    cursor:pointer;
}

.side-menu-item .menu-icon,
.side-menu-item > span{
    pointer-events:none;
}

.side-menu-item:hover,
.side-menu-item.active{
    background:#254aa5;
}

.menu-icon{
    width:23px;
    text-align:center;
    font-size:20px;
}

.side-menu-footer{
    margin-top:auto;
    padding:12px;
    border-top:1px solid rgba(255,255,255,.12);
}

.logout-menu-item{
    color:#e2c300;
    margin-bottom:0;
}

.logout-menu-item:hover{
    background:rgba(226,195,0,.12);
}

body.app-authenticated #menuButton{
    display:block;
}

#loginScreen{
    z-index:9999;
}

/* Preferencias visuais: modo escuro */
body.dark-mode {
    background: #111827 !important;
    color: #e5e7eb !important;
    color-scheme: dark;
}

body.dark-mode #homeScreen,
body.dark-mode #rankingScreen,
body.dark-mode #receiptsScreen,
body.dark-mode #settingsScreen {
    color: #e5e7eb;
}

body.dark-mode .game,
body.dark-mode .ranking-table tbody tr,
body.dark-mode #settingsScreen article,
body.dark-mode [style*="background:#fff"],
body.dark-mode [style*="background: #fff"],
body.dark-mode [style*="background:white"],
body.dark-mode [style*="background: white"] {
    background: #1f2937 !important;
    color: #e5e7eb !important;
    border-color: #374151 !important;
}

body.dark-mode [style*="color:#667085"],
body.dark-mode [style*="color: #667085"],
body.dark-mode [style*="color:#475467"],
body.dark-mode [style*="color: #475467"],
