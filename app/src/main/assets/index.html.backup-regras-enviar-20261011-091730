window.handleGoogleCallback =
async function(callbackUrl){


    if(!callbackUrl){

        setLoginError(
            "Retorno do Google não recebido."
        );

        return;

    }

    try{

        const url =
            new URL(callbackUrl);

        const hashParams =
            new URLSearchParams(
                url.hash
                    ? url.hash.substring(1)
                    : ""
            );

        const callbackType =
            hashParams.get("type") ||
            url.searchParams.get("type") ||
            "";

        const isEmailConfirmation =
            callbackType === "signup" ||
            callbackType === "email";

        console.log(
            "Tipo de retorno de autenticação:",
            callbackType || "não informado"
        );

        const errorDescription =
            hashParams.get(
                "error_description"
            ) ||
            url.searchParams.get(
                "error_description"
            );

        const errorCode =
            hashParams.get("error") ||
            url.searchParams.get("error");

        if(errorDescription || errorCode){

            console.error(
                "Erro retornado pelo OAuth:",
                errorCode,
                errorDescription
            );

            let message =
                errorDescription ||
                errorCode ||
                (
                    isEmailConfirmation
                        ? "Não foi possível confirmar o e-mail."
                        : "A autenticação foi recusada."
                );

            try{

                message =
                    decodeURIComponent(
                        message
                    );

            }catch(_){}

            setLoginError(
                message
            );

            return;

        }

        const accessToken =
            hashParams.get(
                "access_token"
            ) ||
            url.searchParams.get(
                "access_token"
            );

        const refreshToken =
            hashParams.get(
                "refresh_token"
            ) ||
            url.searchParams.get(
                "refresh_token"
            );

        if(
            accessToken &&
            refreshToken
        ){

            console.log(
                "Tokens de autenticação recebidos."
            );

            const {
                data,
                error
            } =
                await supabaseClient.auth.setSession({
                    access_token:
                        accessToken,

                    refresh_token:
                        refreshToken
                });

            if(error){

                console.error(
                    "ERRO AO CRIAR SESSÃO:",
                    error
                );

                setLoginError(
                    error.message ||
                    "Não foi possível criar a sessão."
                );

                return;

            }

            if(
                !data ||
                !data.user
            ){

                setLoginError(
                    "A autenticação foi recebida, mas a sessão não foi criada."
                );

                return;

            }

            currentUser =
                data.user;

            if(callbackType === "recovery"){
                showNewPasswordForm();
                return;
            }

            await finishAuthenticatedLogin();

            return;

        }

        const code =
            url.searchParams.get(
                "code"
            ) ||
            hashParams.get(
                "code"
            );

        if(code){

            const {
                data,
                error
            } =
                await supabaseClient.auth
                    .exchangeCodeForSession(
                        code
                    );

            if(error){

                console.error(
                    "ERRO AO TROCAR CÓDIGO POR SESSÃO:",
                    error
                );

                setLoginError(
                    error.message ||
                    "Não foi possível concluir a autenticação."
                );

                return;

            }

            if(
                !data ||
                !data.user
            ){

                setLoginError(
                    "A autenticação foi concluída, mas o usuário não foi encontrado."
                );

                return;

            }

            currentUser =
                data.user;

            if(callbackType === "recovery"){
                showNewPasswordForm();
                return;
            }

            await finishAuthenticatedLogin();

            return;

        }

        setLoginError(
            "O retorno da autenticação não pôde ser concluído."
        );

    }catch(error){

        console.error(
            "ERRO AO PROCESSAR CALLBACK DE AUTENTICAÇÃO:",
            error
        );

        setLoginError(
            error &&
            error.message
                ? error.message
                : "Erro ao finalizar a autenticação."
        );

    }

};


