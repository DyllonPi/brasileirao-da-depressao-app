/* ============================================================
RANKING
============================================================ */

async function loadRanking(){

    const tableBody = document.getElementById("rankingTableBody");

    if (!tableBody) return;

    tableBody.innerHTML = `
        <tr>
            <td colspan="3" style="text-align:center;padding:15px;color:#666;">
                Carregando ranking...
            </td>
        </tr>
    `;

    try {
        const { data, error } =
            await supabaseClient.rpc("carregar_ranking");

        if (error) throw error;

        if (!data || data.length === 0) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="3" style="text-align:center;padding:15px;color:#666;">
                        Nenhum participante encontrado no ranking.
                    </td>
                </tr>
            `;
            return;
        }

        tableBody.innerHTML = data.map(item => `
            <tr>
                <td class="col-participante">
                    ${item.participante || "Usuário"}
                </td>
                <td class="col-pontuacao">
                    ${Number(item.pontos) || 0}
                </td>
                <td class="col-time">
                    ${item.clube || "-"}
                </td>
            </tr>
        `).join("");

    } catch (err) {
        console.error("Erro ao carregar ranking:", err);

        tableBody.innerHTML = `
            <tr>
                <td colspan="3" style="text-align:center;padding:15px;color:#c62828;">
                    Erro ao carregar o ranking.
                </td>
            </tr>
        `;
    }
}

