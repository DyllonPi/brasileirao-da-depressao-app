/* ============================================================
PREFERENCIAS LOCAIS DO APLICATIVO
============================================================ */

const APP_PREFERENCES_KEY = "brasileirao_depressao_preferences";

function getAppPreferences(){

    const defaults = {
        darkMode: false,
        sound: false
    };

    try {
        const saved = localStorage.getItem(APP_PREFERENCES_KEY);

        if(saved){
            return {
                ...defaults,
                ...JSON.parse(saved)
            };
        }
    } catch(error) {
        console.warn("Não foi possível ler as preferências locais.", error);
    }

    return defaults;
}

function saveAppPreferences(preferences){

    try {
        localStorage.setItem(
            APP_PREFERENCES_KEY,
            JSON.stringify(preferences)
        );
        return true;
    } catch(error) {
        console.warn("Não foi possível salvar as preferências locais.", error);
        return false;
    }
}

function applyAppPreferences(){

    const preferences = getAppPreferences();

    document.body.classList.toggle(
        "dark-mode",
        preferences.darkMode === true
    );

    const darkControl = document.getElementById("settingDarkMode");
    const soundControl = document.getElementById("settingSound");

    if(darkControl){
        darkControl.checked = preferences.darkMode === true;
    }

    if(soundControl){
        soundControl.checked = preferences.sound === true;
    }
}

function setAppPreference(key, value){

    if(key !== "darkMode" && key !== "sound"){
        return;
    }

    const preferences = getAppPreferences();
    preferences[key] = Boolean(value);

    const saved = saveAppPreferences(preferences);

    if(key === "darkMode"){
        document.body.classList.toggle(
            "dark-mode",
            preferences.darkMode
        );
    }

    if(key === "sound"){
        const status = document.getElementById("settingsSoundStatus");

        if(status){
            status.textContent = saved
                ? "Preferência salva. Os efeitos sonoros ainda não estão implementados."
                : "Não foi possível salvar a preferência neste dispositivo.";
        }
    }

    if(!saved){
        console.warn("A preferência pode não persistir após fechar o aplicativo.");
    }
}

/* Aplicar as preferências salvas ao abrir o aplicativo. */
applyAppPreferences();


