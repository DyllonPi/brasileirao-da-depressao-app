                Rodada ${item.rodada}
            </strong>

            <br>

            <span style="color:#666;font-size:13px;">
                Enviado em ${dataEnvio}
            </span>
        `;

        button.onclick = function(){

            showReceiptDetail(
                item.rodada
            );

        };

        if(roundsElement){

            roundsElement.appendChild(
                button
            );

        }

    });

}


